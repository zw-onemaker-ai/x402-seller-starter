# ── Your receiving address (Base mainnet) ─────────────────────────
# Use a dedicated wallet for receiving payments and keep only working
# funds in it. Never commit the real .env.
X402_PAY_TO=0xYourReceivingAddressHere

# ── Server ────────────────────────────────────────────────────────
X402_HOST=127.0.0.1
X402_PORT=4021
# production = Base mainnet. See CDP docs for testnet values.
X402_ENV_MODE=production

# ── Coinbase CDP (facilitator) ────────────────────────────────────
# Free tier available: https://docs.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
